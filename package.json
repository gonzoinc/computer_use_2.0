{
  "name": "computer-use-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Firefox debugging and Windows computer control.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gonzoinc/computer_use_2.0.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node runtime/server.mjs",
    "test": "node --test runtime/*.test.mjs native/bridge.test.mjs firefox/*.test.mjs",
    "test:runtime": "node --test runtime/*.test.mjs",
    "test:native": "node --test native/bridge.test.mjs",
    "test:firefox": "node --test firefox/*.test.mjs",
    "build": "powershell -NoProfile -File scripts/build.ps1"
  }
}
